{
  "name": "outpaly",
  "private": true,
  "type": "module",
  "description": "OutPaly — Playlist Video Studio",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,worker -c yellow,cyan,magenta \"npm run dev -w @outpaly/api\" \"npm run dev -w @outpaly/web\" \"npm run dev -w @outpaly/worker\"",
    "dev:api": "npm run dev -w @outpaly/api",
    "dev:web": "npm run dev -w @outpaly/web",
    "dev:worker": "npm run dev -w @outpaly/worker",
    "build:web": "npm run build -w @outpaly/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "ffmpeg-static@5.3.0": true
  }
}
