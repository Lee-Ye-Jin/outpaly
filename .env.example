# 복사해서 .env 로 쓰세요:  cp .env.example .env

# PostgreSQL (로컬 설치 또는 docker compose)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/outpaly?schema=public"

# API 서버
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
# 배포 시 로드밸런서 뒤에 있으면 프록시 홉 수 (예: 1). 로컬에서는 비워 둔다
TRUST_PROXY=

# Redis (Phase 6 렌더링 대기열부터 사용)
REDIS_URL="redis://localhost:6379"
