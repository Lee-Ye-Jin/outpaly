# 복사해서 .env 로 쓰세요:  cp .env.example .env

# PostgreSQL (로컬 설치 또는 docker compose)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/outpaly?schema=public"

# API 서버
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
# 배포 시 로드밸런서 뒤에 있으면 프록시 홉 수 (예: 1). 로컬에서는 비워 둔다
TRUST_PROXY=

# Redis (지금은 쓰지 않음. 렌더 대기열은 PostgreSQL 로 동작. 작업이 많아져 BullMQ 로 바꿀 때 사용)
REDIS_URL="redis://localhost:6379"

# 렌더링 Worker (모두 비워 두면 개발 기본값)
# 시스템 ffmpeg 를 쓰려면 경로 지정. 비우면 npm 패키지 ffmpeg-static
FFMPEG_PATH=
# 렌더링 임시 파일 위치. 비우면 OS 임시 폴더/outpaly-render
RENDER_WORK_DIR=
# 글꼴 폴더 (NotoSansKR_400Regular.ttf 등). 비우면 @expo-google-fonts 패키지
FONT_DIR=
